# Copy this file to infra/.env and fill in real values before running
# `docker compose up`. Never commit the resulting .env file.

# --- Postgres bootstrap credentials ---
# Superuser used only by the db container itself and by the one-off `migrate`
# job (which creates the api_service/ml_trainer roles below). The running
# backend never uses these.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=sentinelai

# --- Least-privilege application role passwords ---
# api_service: full read/write on the `app` schema, explicitly no access to
#   `ground_truth`. Used by the running backend (and, later, by agent tools).
# ml_trainer: read-only on `app` and `ground_truth`. Used only by the offline
#   ml/ training pipeline (not implemented in Phase 1).
API_SERVICE_DB_PASSWORD=change_me_api_service_password
ML_TRAINER_DB_PASSWORD=change_me_ml_trainer_password

# --- Phase 5: auth ---
# JWT_SECRET_KEY signs analyst/senior_analyst/admin session tokens
# (app/core/security.py); SERVICE_API_KEY is the separate machine
# credential for the `service` principal (docs/api-contracts.md §0) used
# by POST /transactions/ingest, POST /risk/score, and POST /risk-scores
# (Phase 6 Part A extended service-role auth to the first two).
# Generate real values with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_jwt_secret_key
SERVICE_API_KEY=change_me_service_api_key
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Phase 6: investigation agents ---
# LLM_PROVIDER=mock is the only value this demo environment can actually
# run (no ANTHROPIC_API_KEY/OPENAI_API_KEY configured) — see
# docs/agent-security.md §1. Set to "anthropic"/"openai" plus the
# matching key below to use a real model; an unset key with a real
# provider selected fails fast rather than silently using mock output.
LLM_PROVIDER=mock
LLM_MODEL_NAME=mock-deterministic-v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGENT_NODE_TIMEOUT_SECONDS=30

# --- Host port mappings ---
# Adjust these if they collide with something else already running on your
# machine.
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8001
FRONTEND_HOST_PORT=5173
